{
	"name": "toolbox",
	"version": "0.1.0",
	"description": "A modular Obsidian plugin that bundles several small quality-of-life tools.",
	"type": "module",
	"private": true,
	"license": "MIT",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"typecheck": "tsc -p tsconfig.json && tsc -p packages/protocol && tsc -p packages/server && tsc -p tsconfig.tools.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "npm run typecheck && npm run lint && npm run test",
		"server:up": "docker compose -f packages/server/docker-compose.yml up -d --build",
		"server:down": "docker compose -f packages/server/docker-compose.yml down",
		"server:logs": "docker compose -f packages/server/docker-compose.yml logs -f --tail 100",
		"server:status": "docker compose -f packages/server/docker-compose.yml ps"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin"
	],
	"devDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@types/node": "^26.5.0",
		"@types/ws": "^8.18.1",
		"esbuild": "0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.12.0",
		"jsdom": "^30.0.1",
		"obsidian": "^1.13.1",
		"prettier": "^3.9.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"y-codemirror.next": "^0.3.6",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.32"
	}
}

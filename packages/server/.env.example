# Copy to .env and fill in. Generate the secret with:
#   openssl rand -hex 32
#
# Required to create a NEW vault. Existing vaults authenticate with their own
# token, derived from the ring code, which never reaches the server.
#
# At least 32 characters. There is no lockout beyond ten attempts a quarter of an
# hour, so let openssl choose this rather than choosing it yourself.
SIGNET_REGISTRATION_SECRET=

# Optional
# SIGNET_PORT=8787
# SIGNET_MAX_BLOB_BYTES=104857600
# SIGNET_MAX_MANIFEST_BYTES=33554432

# Ceiling on what one vault may occupy. Nothing on this server is ever deleted,
# so this is the only thing that bounds disk use — reaching it stops that vault
# syncing rather than removing anything. 0 switches the check off.
# SIGNET_MAX_VAULT_BYTES=53687091200

# Which interface to listen on. The container sets this to 0.0.0.0 itself,
# because inside a container that is what makes the published port reachable;
# what decides who can connect is the port binding in docker-compose.yml. Set it
# here only if you are running the server outside Docker.
# SIGNET_HOST=127.0.0.1

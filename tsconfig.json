{
	// The Obsidian plugin.
	//
	// `types: []` is the load-bearing line. Obsidian on a phone is not Node, so a
	// plugin that reaches for `node:fs` or `process` compiles happily and then
	// fails on exactly the device that is hardest to debug on. Without Node's
	// types in scope, that mistake is a compile error instead.
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2021"],
		"types": []
	},
	"include": ["src/**/*.ts"]
}

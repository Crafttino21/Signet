{
	// Shared with every package. Nothing platform-specific belongs here: the
	// plugin runs in Obsidian, the server runs in Node, and mixing their type
	// libraries is how a plugin ends up importing `node:fs` and working on the
	// desktop while crashing on a phone.
	"compilerOptions": {
		"target": "ES2021",
		"module": "ESNext",
		"moduleResolution": "bundler",

		"strict": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,

		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"skipLibCheck": true,

		"noEmit": true,
		"inlineSourceMap": true,
		"inlineSources": true
	}
}
